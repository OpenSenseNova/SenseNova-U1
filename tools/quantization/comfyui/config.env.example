# Copy this file to config.env and edit the paths before running the wrappers.
# The wrappers also accept these values from the environment.

U1_SOURCE_DIR=/path/to/hf_checkpoint
U1_OUTPUT_DIR=./outputs/quantization

# The INT8 wrapper consumes the BF16 file produced by convert_bf16.sh.
COMFYUI_BF16_OUTPUT=${U1_OUTPUT_DIR}/sensenova/SenseNova-U1.6-8B-MoT-ComfyUI/checkpoints/SenseNova-U1.6-BF16.safetensors
COMFYUI_INT8_OUTPUT=${U1_OUTPUT_DIR}/sensenova/SenseNova-U1.6-8B-MoT-ComfyUI/checkpoints/SenseNova-U1.6-INT8-ConvRot.safetensors

# 1 keeps the ComfyUI auto-exporter's default and quantizes token embeddings.
# Set to 0 to keep embed_tokens in BF16, matching the native tools converter.
COMFYUI_QUANTIZE_EMBEDDINGS=1
CUDA_VISIBLE_DEVICES=0
